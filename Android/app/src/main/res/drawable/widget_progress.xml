<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="999dp"/>
            <gradient android:angle="270" android:startColor="#121417" android:endColor="#1B1E23"/>
            <stroke android:width="1dp" android:color="#2C3138"/>
        </shape>
    </item>
    <item android:id="@android:id/progress" android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <shape android:shape="rectangle">
                <corners android:radius="999dp"/>
                <gradient android:angle="90" android:startColor="#A8E23C" android:endColor="#D8FF72"/>
            </shape>
        </scale>
    </item>
</layer-list>
