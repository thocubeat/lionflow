<?xml version="1.0" encoding="utf-8"?>
<!-- Card with a soft green glow in the bottom-right corner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/widget_card"/>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <gradient android:type="radial" android:centerX="1.0" android:centerY="1.0" android:gradientRadius="130dp"
                android:startColor="#80B6EE3C" android:centerColor="#26B6EE3C" android:endColor="#00B6EE3C"/>
        </shape>
    </item>
</layer-list>
